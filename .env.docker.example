# =============================================================================
# Runtime environment contract for the j2it.com container image
# =============================================================================
#
# The published image (ghcr.io/xtreemmak/j2it.us) contains NO configuration.
# Every value below is read at container start via SvelteKit's $env/dynamic/*,
# which means the same image digest runs in any environment.
#
# Infra (Semaphore) owns the real values. Copy this file, fill it in, and mount
# it as the container's env file:
#
#   cp .env.docker.example .env
#   docker compose -f docker-compose.prod.yml up -d
#
# Values marked REQUIRED will break a feature if unset.
# Values marked SECRET must come from the secret store, never from git.
# =============================================================================

# --- Deployment knobs (read by docker-compose, not by the app) ---------------
# Image tag or digest to run. Prefer an immutable sha/semver tag in production.
IMAGE_TAG=latest
# Host port to publish the container's port 3000 on.
APP_PORT=3000

# --- Core application --------------------------------------------------------
# REQUIRED. Base URL for images and static assets. Point at the CDN in prod.
PUBLIC_CDN_URL=https://cdn.j2it.us

# --- Webhooks / n8n integration ---------------------------------------------
# SECRET. Signs the JWT sent with webhook payloads. Contact forms fail without it.
WEBHOOK_JWT_SECRET=
# SECRET. REQUIRED for the contact form.
N8N_CONTACT_WEBHOOK_URL=
# SECRET. REQUIRED for the IT health-check form.
N8N_HEALTH_CHECK_WEBHOOK_URL=

# --- Rate limiting -----------------------------------------------------------
# Optional; these are also the in-code defaults.
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=10

# --- Google Places (reviews section) ----------------------------------------
# SECRET. Server-side only; never reaches the browser.
GOOGLE_PLACES_API_KEY=
# The place whose reviews are shown. Reviews section hides itself if unset.
GOOGLE_BUSINESS_PLACE_ID=

# --- Tawk.to live chat -------------------------------------------------------
# Optional. Widget is skipped entirely when either is unset.
PUBLIC_TAWK_PROPERTY_ID=
PUBLIC_TAWK_WIDGET_ID=

# --- Feature toggles ---------------------------------------------------------
# Must be the literal string "true" to enable.
PUBLIC_SCHEDULE_CALL_ENABLED=false
PUBLIC_INSIGHTS_ENABLED=false

# --- Schema.org LocalBusiness data (rendered into every page's JSON-LD) ------
PUBLIC_BUSINESS_NAME=J² IT Solutions
PUBLIC_BUSINESS_ALT_NAME=J2IT
PUBLIC_BUSINESS_URL=https://www.j2it.us
PUBLIC_BUSINESS_DESCRIPTION=Affordable IT support and web solutions for small businesses. Flat monthly pricing, no contracts, personal service.
PUBLIC_BUSINESS_EMAIL=contact@j2it.us
PUBLIC_BUSINESS_PRICE_RANGE=$$
PUBLIC_BUSINESS_PHONE=
PUBLIC_BUSINESS_STREET=
PUBLIC_BUSINESS_CITY=
PUBLIC_BUSINESS_STATE=
PUBLIC_BUSINESS_ZIP=
PUBLIC_BUSINESS_COUNTRY=
PUBLIC_BUSINESS_LATITUDE=
PUBLIC_BUSINESS_LONGITUDE=

# --- Founder / business details ----------------------------------------------
PUBLIC_FOUNDER_NAME=Jamaal Ephriam
PUBLIC_FOUNDER_TITLE=IT Solutions Expert
PUBLIC_BUSINESS_AREA_SERVED=Florida
PUBLIC_BUSINESS_HOURS_DAYS=Monday,Tuesday,Wednesday,Thursday,Friday
PUBLIC_BUSINESS_HOURS_OPEN=09:00
PUBLIC_BUSINESS_HOURS_CLOSE=17:00

# --- Digital business cards (/card and /card/<id>) ---------------------------
# Cards are discovered by scanning for CARD_<ID>_NAME. Add a new card by adding
# a new prefix block; no code change is needed.
CARD_DEFAULT_NAME=J² IT Solutions
CARD_DEFAULT_PERSON=Jamaal Ephriam
CARD_DEFAULT_TITLE=IT Solutions Expert
CARD_DEFAULT_COMPANY=J²it: IT and Web Solutions
CARD_DEFAULT_PHONE=
CARD_DEFAULT_EMAIL=contact@j2it.us
CARD_DEFAULT_WEBSITE=https://j2it.us
CARD_DEFAULT_STREET=
CARD_DEFAULT_CITY=Coconut Creek
CARD_DEFAULT_STATE=FL
CARD_DEFAULT_ZIP=33073
CARD_DEFAULT_COUNTRY=USA
CARD_DEFAULT_IMAGE=Jamaal_Photo.webp

CARD_JAMAAL_NAME=J² IT Solutions
CARD_JAMAAL_PERSON=Jamaal Ephriam
CARD_JAMAAL_TITLE=IT Solutions Expert
CARD_JAMAAL_PHONE=
CARD_JAMAAL_EMAIL=jamaal@j2it.us
CARD_JAMAAL_STREET=
CARD_JAMAAL_CITY=Coconut Creek
CARD_JAMAAL_STATE=FL
CARD_JAMAAL_ZIP=33073
CARD_JAMAAL_COUNTRY=USA
CARD_JAMAAL_IMAGE=Jamaal_Photo.webp
